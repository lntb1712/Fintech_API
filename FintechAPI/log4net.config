<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<log4net>
		<!-- ====================== LOG VÀO DATABASE (giữ nguyên như cũ) ====================== -->
		<appender name="AdoNetAppender" type="log4net.Appender.AdoNetAppender">
			<bufferSize value="1" />
			<connectionType value="System.Data.SqlClient.SqlConnection, System.Data" />
			<connectionString value="${log4net:Log4NetConnection}" />
			<commandText value="INSERT INTO Template_Log (LogType, UserId, Endpoint, ParamsOrBody, CreatedDate, Message) 
                          VALUES (@logType, @userId, @endpoint, @paramsOrBody, @createdDate, @messageResponse)" />

			<parameter>
				<parameterName value="@logType" />
				<dbType value="String" />
				<size value="50" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%level" />
				</layout>
			</parameter>
			<parameter>
				<parameterName value="@userId" />
				<dbType value="String" />
				<size value="100" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%property{userId}" />
				</layout>
			</parameter>
			<parameter>
				<parameterName value="@endpoint" />
				<dbType value="String" />
				<size value="200" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%property{endpoint}" />
				</layout>
			</parameter>
			<parameter>
				<parameterName value="@paramsOrBody" />
				<dbType value="String" />
				<size value="4000" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%property{paramsOrBody}" />
				</layout>
			</parameter>
			<parameter>
				<parameterName value="@messageResponse" />
				<dbType value="String" />
				<size value="4000" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%property{messageResponse}" />
				</layout>
			</parameter>
			<parameter>
				<parameterName value="@createdDate" />
				<dbType value="DateTime" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff}" />
				</layout>
			</parameter>
			<threshold value="ERROR" />
		</appender>

		<!-- ====================== LOG RA FILE TXT (mới thêm - siêu tiện) ====================== -->
		<appender name="RequestFileAppender" type="log4net.Appender.FileAppender">
			<file value="Logs/request_logs.txt" />
			<!-- sẽ tự tạo thư mục Logs nếu chưa có -->
			<appendToFile value="true" />
			<filter type="log4net.Filter.LevelRangeFilter">
				<levelMin value="INFO" />
				<levelMax value="INFO" />
				<!-- Chỉ nhận INFO -->
			</filter>
			<!-- Ghi thêm, không đè -->
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
			<!-- Tránh conflict khi nhiều request cùng lúc -->
			<layout type="log4net.Layout.PatternLayout">
				<!-- Dòng log đẹp, dễ copy curl luôn -->
				<conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} |%property{level} | %property{userId} | %property{endpoint} | %message%newline" />
			</layout>
			<encoding value="utf-8" />
			<threshold value="INFO" />
		</appender>

		<logger name="Common.Authorization.ErrorHandlerMiddleware">
			<level value="ALL" />
			<appender-ref ref="AdoNetAppender" />
			<appender-ref ref="RequestFileAppender" />
		</logger>
	</log4net>
</configuration>